{
  "expo": {
    "name": "Sân Nhà",
    "slug": "san-nha-club",
    "scheme": "sannha",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.sannha.club"
    },
    "android": {
      "package": "vn.sannha.club",
      "adaptiveIcon": {
        "backgroundColor": "#085041",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b6e173d0-724c-41c8-9642-99c90476eeba"
      },
      "updateRepo": "trankien27/san-nha-app"
    },
    "owner": "trantrungkienl2703"
  }
}
